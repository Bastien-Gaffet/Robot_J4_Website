{
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/login", "destination": "/login.html" },
      { "source": "/home", "destination": "/home.html" },
      { "source": "/play*", "destination": "/play.html" },
      { "source": "/leaderboard", "destination": "/leaderboard.html" },
      { "source": "/profile*", "destination": "/profile.html" },
      { "source": "/replay*", "destination": "/replay.html" },
      { "source": "/choose-username*", "destination": "/choose-username.html" },
      { "source": "/game-history*", "destination": "/game-history.html" },
      { "source": "/account", "destination": "/account.html" },
      { "source": "/404", "destination": "/404.html" }
    ]
  }
}
