<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Partie Multijoueur</title>
  <link rel="icon" href="images/logo.png" type="image/png">
  <link rel="stylesheet" href="css/global.css" />
  <link rel="stylesheet" href="css/multiplayer.css" />
</head>
<body>
  <!-- Common navigation bar -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-logo">
        <img src="/images/logo.png" alt="Logo" />
      </div>
      <div id="nav-links" class="nav-links"></div>
    </div>
  </nav>

  <!-- Mobile top-navigation bar -->
  <div id="top-mobile-navbar" class="top-mobile-navbar"></div>

  <div id="loading-screen">
    <span class="loader"></span>
    <p>Recherche d'un adversaire en cours...</p>
  </div>

  <div id="game-container" class="hidden">
    <div id="opponent-info" class="player-info">
      <img id="opponent-avatar" src="" alt="Avatar adversaire" class="avatar" />
      <div>
        <p id="opponent-pseudo" class="pseudo">Adversaire</p>
        <p id="opponent-elo" class="elo">ELO: ???</p>
        <p id="opponent-timer" class="timer">5:00</p>
      </div>
    </div>

    <div id="grid"></div>

    <div id="your-info" class="player-info">
      <img id="your-avatar" src="" alt="Votre avatar" class="avatar" />
      <div>
        <p id="your-pseudo" class="pseudo">Vous</p>
        <p id="your-elo" class="elo">ELO: ???</p>
        <p id="your-timer" class="timer">5:00</p>
      </div>
    </div>
  </div>

  <!-- Back to Top Button -->
  <button id="backtotopBtn" title="Back to top">↑</button>
  <script src="js/global.js"></script>
  
  <!-- Bottom Navigation Bar pour mobile -->
  <nav class="bottom-nav"></nav>
  <script type="module" src="/js/navbar-controller.js"></script>

  <script type="module" src="js/multiplayer.js"></script>
</body>
</html>
